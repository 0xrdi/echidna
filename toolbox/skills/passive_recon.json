{
  "id": "passive-recon",
  "name": "Passive Reconnaissance",
  "version": "1.0",
  "description": "Gather intelligence about a target through publicly available sources without making direct contact with target infrastructure.",
  "mitre_techniques": [
    "T1589",
    "T1590",
    "T1591",
    "T1592",
    "T1593",
    "T1594",
    "T1596",
    "T1597"
  ],
  "allowed_binaries": [
    "curl",
    "wget",
    "dig",
    "whois",
    "python3",
    "subfinder",
    "head",
    "tail",
    "cat",
    "jq",
    "grep",
    "sort",
    "uniq",
    "wc"
  ],
  "allow_proxy": false,
  "allow_delegate": false,
  "allow_file_write": true,
  "allow_file_read": true,
  "requires_proxy": false,
  "requires_callback_access": false,
  "output_schema": {
    "type": "object",
    "required": [
      "skill",
      "target",
      "status",
      "findings"
    ],
    "properties": {
      "skill": {
        "type": "string",
        "const": "passive-recon"
      },
      "target": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "partial",
          "error"
        ]
      },
      "confidence": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low"
        ]
      },
      "findings": {
        "type": "object",
        "properties": {
          "domains": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "registrar": {
                  "type": "string"
                },
                "nameservers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "email_format": {
            "type": "string"
          },
          "employees": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                }
              }
            }
          },
          "tech_stack": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "technology": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                },
                "confidence": {
                  "type": "string"
                }
              }
            }
          },
          "cloud_assets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string"
                },
                "asset": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                }
              }
            }
          },
          "leaked_credentials": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "has_password": {
                  "type": "boolean"
                }
              }
            }
          },
          "certificates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "subject": {
                  "type": "string"
                },
                "issuer": {
                  "type": "string"
                },
                "san": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "source": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "recommendations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "next_skill": {
              "type": "string"
            },
            "priority": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
