{
  "id": "credential-validation",
  "name": "Credential Validator",
  "version": "1.0",
  "description": "Test recovered credentials against their target services to determine scope and validity. Read-only validation with single authentication attempts only.",
  "mitre_techniques": [
    "T1078",
    "T1110.001"
  ],
  "allowed_binaries": [
    "cat",
    "curl",
    "grep",
    "head",
    "jq",
    "python3",
    "tail",
    "nc"
  ],
  "allow_proxy": true,
  "allow_delegate": true,
  "allow_file_write": true,
  "allow_file_read": true,
  "requires_proxy": false,
  "requires_callback_access": false,
  "output_schema": {
    "type": "object",
    "required": [
      "skill",
      "target",
      "status",
      "findings"
    ],
    "properties": {
      "skill": {
        "type": "string",
        "const": "credential-validation"
      },
      "target": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "partial",
          "error"
        ]
      },
      "findings": {
        "type": "object",
        "properties": {
          "credentials_tested": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "credential_source": {
                  "type": "string"
                },
                "username": {
                  "type": "string"
                },
                "target_service": {
                  "type": "string"
                },
                "protocol": {
                  "type": "string"
                },
                "valid": {
                  "type": "boolean"
                },
                "access_scope": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "recommendations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "next_skill": {
              "type": "string"
            },
            "priority": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
