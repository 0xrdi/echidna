{
  "id": "cloud-enumeration",
  "name": "Cloud Resource Enumerator",
  "version": "1.0",
  "description": "Enumerate cloud resources across AWS, GCP, and Azure using recovered credentials or instance metadata. Read-only enumeration of resource existence, configuration, and access scope.",
  "mitre_techniques": [
    "T1580",
    "T1538",
    "T1526"
  ],
  "allowed_binaries": [
    "cat",
    "curl",
    "grep",
    "head",
    "jq",
    "python3",
    "tail",
    "aws",
    "gcloud",
    "az"
  ],
  "allow_proxy": true,
  "allow_delegate": true,
  "allow_file_write": true,
  "allow_file_read": true,
  "requires_proxy": false,
  "requires_callback_access": false,
  "output_schema": {
    "type": "object",
    "required": [
      "skill",
      "target",
      "status",
      "findings"
    ],
    "properties": {
      "skill": {
        "type": "string",
        "const": "cloud-enumeration"
      },
      "target": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "partial",
          "error"
        ]
      },
      "findings": {
        "type": "object",
        "properties": {
          "cloud_provider": {
            "type": "string"
          },
          "identity": {
            "type": "object",
            "properties": {
              "account_id": {
                "type": "string"
              },
              "arn": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "access_level": {
                  "type": "string"
                },
                "misconfiguration": {
                  "type": "string"
                }
              }
            }
          },
          "iam_policies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "effect": {
                  "type": "string"
                },
                "actions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "resources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "network_exposure": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "resource": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "exposure": {
                  "type": "string"
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "recommendations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "next_skill": {
              "type": "string"
            },
            "priority": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
