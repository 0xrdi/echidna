{
  "id": "privilege-escalation",
  "name": "Privilege Escalation Executor",
  "version": "1.0",
  "description": "Escalate privileges on compromised hosts using known paths such as sudo misconfigurations, SUID binaries, group membership abuse, kernel exploits, and other confirmed escalation vectors identified by prior skills.",
  "mitre_techniques": [
    "T1548.001",
    "T1548.003",
    "T1068",
    "T1611"
  ],
  "allowed_binaries": [
    "cat",
    "curl",
    "grep",
    "head",
    "jq",
    "python3",
    "tail"
  ],
  "allow_proxy": false,
  "allow_delegate": true,
  "allow_file_write": true,
  "allow_file_read": true,
  "requires_proxy": false,
  "requires_callback_access": true,
  "output_schema": {
    "type": "object",
    "required": [
      "skill",
      "target",
      "status",
      "findings"
    ],
    "properties": {
      "skill": {
        "type": "string",
        "const": "privilege-escalation"
      },
      "target": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "partial",
          "error"
        ]
      },
      "findings": {
        "type": "object",
        "properties": {
          "original_user": {
            "type": "object",
            "properties": {
              "username": {
                "type": "string"
              },
              "privileges": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "is_root": {
                "type": "boolean"
              }
            }
          },
          "escalated_user": {
            "type": "object",
            "properties": {
              "username": {
                "type": "string"
              },
              "privileges": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "is_root": {
                "type": "boolean"
              }
            }
          },
          "technique_used": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "mitre_id": {
                "type": "string"
              },
              "commands_executed": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "revert_commands": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "additional_access": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "resource": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "recommendations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "next_skill": {
              "type": "string"
            },
            "priority": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
