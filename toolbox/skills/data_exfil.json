{
  "id": "data-exfil",
  "name": "Data Exfiltration Agent",
  "version": "1.0",
  "description": "Identify, stage, and exfiltrate high-value data from compromised hosts using stealthy transfer methods via active implants.",
  "mitre_techniques": [
    "T1005",
    "T1039",
    "T1025",
    "T1041",
    "T1048",
    "T1567"
  ],
  "allowed_binaries": [
    "cat",
    "jq",
    "head",
    "tail",
    "grep",
    "python3",
    "base64",
    "curl"
  ],
  "allow_proxy": false,
  "allow_delegate": true,
  "allow_file_write": true,
  "allow_file_read": true,
  "requires_proxy": false,
  "requires_callback_access": true,
  "output_schema": {
    "type": "object",
    "required": [
      "skill",
      "target",
      "status",
      "findings"
    ],
    "properties": {
      "skill": {
        "type": "string",
        "const": "data-exfil"
      },
      "target": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "partial",
          "error"
        ]
      },
      "findings": {
        "type": "object",
        "properties": {
          "data_identified": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "size": {
                  "type": "string"
                },
                "priority": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "data_exfiltrated": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_path": {
                  "type": "string"
                },
                "method": {
                  "type": "string"
                },
                "size": {
                  "type": "string"
                },
                "integrity_hash": {
                  "type": "string"
                },
                "success": {
                  "type": "boolean"
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "recommendations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "next_skill": {
              "type": "string"
            },
            "priority": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
